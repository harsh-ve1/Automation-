{
  "workflows": {
    "template-gmail-to-drive": {
      "id": "template-gmail-to-drive",
      "name": "Save Email Invoices to Google Drive",
      "prompt": "When I receive an email with an invoice, extract the attachment and save it to Google Drive",
      "active": false,
      "trigger": {
        "type": "event",
        "platform": "gmail",
        "config": {
          "folder": "INBOX",
          "subjectFilter": "invoice"
        }
      },
      "steps": [
        {
          "id": "step-1-ai-extract",
          "platform": "openai",
          "action": "analyze_invoice",
          "config": {
            "prompt": "Analyze this email and return a summary of the invoice"
          },
          "mapping": {
            "emailText": "{{trigger.body}}"
          }
        },
        {
          "id": "step-2-save-drive",
          "platform": "google_drive",
          "action": "save_file",
          "config": {
            "folderName": "Invoices"
          },
          "mapping": {
            "fileName": "invoice_{{trigger.id}}.pdf",
            "fileContent": "{{trigger.attachment}}"
          }
        }
      ],
      "createdAt": "2026-07-14T10:50:54.797Z",
      "updatedAt": "2026-07-14T10:50:54.797Z"
    },
    "template-stripe-to-slack": {
      "id": "template-stripe-to-slack",
      "name": "Notify Slack of New Stripe Payments",
      "prompt": "Notify the team on Slack whenever a customer makes a payment on Stripe",
      "active": false,
      "trigger": {
        "type": "webhook",
        "platform": "stripe",
        "config": {
          "event": "charge.succeeded"
        }
      },
      "steps": [
        {
          "id": "step-1-notify-slack",
          "platform": "slack",
          "action": "send_message",
          "config": {
            "channel": "sales-alerts"
          },
          "mapping": {
            "text": "🎉 New sale! Customer {{trigger.customer_name}} just paid {{trigger.amount_formatted}}."
          }
        }
      ],
      "createdAt": "2026-07-14T10:50:54.797Z",
      "updatedAt": "2026-07-14T10:50:54.797Z"
    },
    "wf-h2m2irixw": {
      "id": "wf-h2m2irixw",
      "name": "Stripe to Google drive & Slack",
      "prompt": "When I get a customer payment on Stripe, notify the sales team on Slack and save receipt to Google Drive",
      "active": false,
      "trigger": {
        "type": "webhook",
        "platform": "stripe",
        "config": {
          "event": "charge.succeeded"
        }
      },
      "steps": [
        {
          "id": "step-1-drive",
          "platform": "google_drive",
          "action": "save_file",
          "config": {
            "folderName": "Automation Files"
          },
          "mapping": {
            "fileName": "file_{{trigger.id}}.txt",
            "fileContent": "{{trigger.body}}"
          }
        },
        {
          "id": "step-2-slack",
          "platform": "slack",
          "action": "send_message",
          "config": {
            "channel": "general"
          },
          "mapping": {
            "text": "🎉 Stripe payment received from {{trigger.customer_name}}! Amount: {{trigger.amount_formatted}}."
          }
        }
      ],
      "createdAt": "2026-07-14T15:14:03.925Z",
      "updatedAt": "2026-07-14T15:14:03.925Z"
    }
  },
